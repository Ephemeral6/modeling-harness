    "numpy>=1.26,<3",
    "scipy>=1.11,<2",
    "pandas>=2,<4",
    "matplotlib>=3.8,<4",
    "scikit-learn>=1.4,<2",
    "statsmodels>=0.14,<1",
    "openpyxl>=3.1,<4"
