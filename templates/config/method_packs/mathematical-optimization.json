  "required_tests": ["穷举或解析 toy", "约束残差", "下界或 gap", "独立后端对拍"],
  "fallbacks": ["精确求解超时则给界、可行解和启发式质量证据"],
  "tool_policy": {
    "decision_required": true,
    "required_capabilities": [],
    "preferred_capabilities": ["continuous_optimization", "mixed_integer_optimization", "constraint_programming", "formal_constraints"],
    "validation_protocols": ["穷举 toy", "约束残差", "双后端对拍", "最优性 gap"]
  }
