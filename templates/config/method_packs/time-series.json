{
  "name": "time-series",
  "version": "1.0.0",
  "description": "带泄漏防护、滚动验证和强基线的时间序列建模。",
  "task_types": ["forecasting", "time_series"],
  "protocol": [
    "按时间而非随机方式切分训练、验证与测试",
