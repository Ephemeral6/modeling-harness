    "与季节朴素、漂移和简单指数平滑基线比较",
    "滚动回测并报告多步误差、区间覆盖和失效时段"
  ],
  "required_tests": ["时间泄漏检查", "季节朴素基线", "滚动回测", "区间覆盖"],
  "fallbacks": ["结构突变显著时分段建模或报告情景区间"],
  "tool_policy": {
    "decision_required": true,
    "required_capabilities": ["time_series"],
    "preferred_capabilities": ["statistics", "machine_learning", "diagnostic_plotting"],
    "validation_protocols": ["滚动回测", "季节朴素基线", "区间覆盖"]
  }
}
