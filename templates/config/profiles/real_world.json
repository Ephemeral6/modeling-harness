{
  "name": "real_world",
  "version": "1.0.0",
  "renderer": "decision_and_deployment_packet",
  "max_parallel_agents": 3,
  "mandatory_outputs": [
    "stakeholder_objective",
    "data_governance",
    "decision_policy",
    "monitoring_plan",
    "rebuild_triggers"
  ],
