    "objective_or_utility_change",
    "new_external_data_authorization",
    "deployment_or_external_write"
  ],
  "report_sections": [
    "Decision Context",
    "Data Contract",
    "Model",
    "Validation",
    "Action",
    "Monitoring"
  ],
  "quality_dimensions": [
    "decision_utility",
    "operational_feasibility",
    "data_governance",
    "monitorability"
  ],
  "min_figures": 0,
  "min_external_references": 0,
  "format_spec": null,
  "required_sections": [
    "Decision Context",
    "Data Contract",
    "Model",
    "Validation",
    "Action",
    "Monitoring"
  ]
}
