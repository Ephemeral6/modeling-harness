{
  "name": "cumcm",
  "version": "1.0.0",
  "renderer": "competition_answer_by_subquestion",
  "max_parallel_agents": 3,
  "mandatory_outputs": [
    "subquestion_results",
    "algorithm_process",
    "reproducible_code",
    "error_analysis"
  ],
  "human_checkpoints": [],
  "report_sections": ["问题重述", "逐问模型与算法", "数值结果", "检验", "评价"],
  "quality_dimensions": [
    "numeric_correctness",
    "process_completeness",
    "reproducibility",
    "robustness"
  ]
}
