{
  "schema": 1,
  "entries": [
    {
      "id": "RC-provenance-source",
      "round": 11,
      "kind": "artifact_value",
      "artifact": "results/q2_plan.json",
      "path": "source",
      "expected": "manual_incumbent",
      "comparison": "eq",
      "summary": "在位解来源标签不得改回扫描标签（v11 M03）"
    },
    {
      "id": "RC-three-paths",
      "round": 11,
      "kind": "forbidden_text",
      "regex": true,
      "targets": ["paper/draft.md", "paper/final.md", "paper/src/00_summary.md"],
      "pattern": "(三|3) ?(条|路)[^。]{0,15}(路径|复算)",
      "summary": "上界复核是四条路径且仅符号积分一路独立，不得改回三路口径（v11 M01）"
    },
    {
      "id": "RC-cpsat-provenance",
      "round": 11,
      "kind": "forbidden_text",
      "regex": true,
      "targets": ["paper/draft.md", "paper/final.md", "paper/src/00_summary.md"],
      "pattern": "CP-?SAT[^。]{0,30}(搜出|搜索|复现|得到)|(热启动|warm[- ]?start)[^。]{0,30}CP-?SAT",
      "summary": "在位解是手工构造的，不得以任何句式宣称由 CP-SAT 搜索得到（v11 M02/M17）"
    },
    {
      "id": "RC-no-search-record",
      "round": 11,
      "kind": "required_text",
      "regex": true,
      "targets": ["paper/draft.md", "paper/final.md"],
      "pattern": "没有可核对的搜索记录",
      "negation_window": ["撤回", "更正", "并非", "实为", "确由", "复现"],
      "window_chars": 60,
      "summary": "在位解无搜索记录的披露必须保留且不得被就地否定（v11 M17）"
    },
    {
      "id": "RC-scope-sentence",
      "round": 11,
      "kind": "required_text",
      "regex": true,
      "targets": ["paper/draft.md", "paper/final.md"],
      "pattern": "整数背包上界只对固定周期与整批构成的计划成立",
      "negation_window": ["撤回", "已不需要"],
      "window_chars": 50,
      "summary": "背包上界的作用域区分句不得删除（v11 M15/M18）"
    },
    {
      "id": "RC-knapsack-any-plan",
      "round": 11,
      "kind": "forbidden_text",
      "regex": true,
      "targets": ["paper/draft.md", "paper/final.md", "paper/src/00_summary.md"],
      "pattern": "背包上界[^。]{0,30}任意计划|任意计划[^。]{0,20}背包上界",
      "summary": "背包上界不得宣称对任意计划成立（v11 M18）"
    },
    {
      "id": "RC-optimality-scope",
      "round": 11,
      "kind": "forbidden_text",
      "regex": true,
      "targets": ["paper/draft.md", "paper/final.md", "paper/src/00_summary.md"],
      "pattern": "全[场局]最优|全空间[^。]{0,6}最优|最优(计划|方案|解|点)",
      "summary": "最优性宣称词族整体禁用，改写句式同样命中（v11 M04）"
    },
    {
      "id": "RC-optimality-disclosure",
      "round": 11,
      "kind": "required_text",
      "regex": true,
      "targets": ["paper/draft.md", "paper/final.md"],
      "pattern": "最优性作用域仅限已探索的构造类",
      "summary": "最优性作用域限定句不得删除（v11 M04）"
    },
    {
      "id": "RC-report-set-label",
      "round": 11,
      "kind": "required_text",
      "regex": true,
      "targets": ["paper/draft.md", "paper/final.md"],
      "pattern": "报告集 ?n ?= ?200",
      "summary": "问题三头条必须带情景集标签（v11 M05）"
    },
    {
      "id": "RC-assumption-a12",
      "round": 11,
      "kind": "required_text",
      "regex": true,
      "targets": ["paper/draft.md", "paper/final.md"],
      "pattern": "A12 \\| 育肥期自断奶日起算",
      "summary": "假设 A12 的读法是自断奶日起算，就地改写即红（v11 M21）"
    },
    {
      "id": "RC-layer1-frontier",
